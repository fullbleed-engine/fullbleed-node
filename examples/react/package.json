{
  "name": "fullbleed-react-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "assets": "fullbleed-browser-assets public/fullbleed",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && npm run assets && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "fullbleed": "0.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
