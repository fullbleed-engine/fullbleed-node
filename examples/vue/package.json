{
  "name": "fullbleed-vue-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "assets": "fullbleed-browser-assets public/fullbleed",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "check": "vue-tsc --noEmit",
    "build": "npm run check && npm run assets && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "fullbleed": "0.8.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@rolldown/binding-wasm32-wasi": "1.2.12",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.12"
  },
  "overrides": {
    "@rolldown/binding-wasm32-wasi": {
      "@napi-rs/wasm-runtime": "1.2.5"
    }
  }
}
