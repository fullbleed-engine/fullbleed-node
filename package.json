{
  "name": "fullbleed",
  "version": "0.8.0",
  "description": "Generate PDFs from HTML/CSS, components or JSX in Node.js, browsers and Cloudflare Workers, with bundled fonts and PNG previews.",
  "type": "module",
  "main": "./src/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./src/index.cjs"
      }
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./dist/browser/client.js"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./ui": {
      "browser": {
        "types": "./src/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "import": {
        "types": "./src/ui.d.ts",
        "default": "./src/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./src/ui.cjs"
      }
    },
    "./ui/jsx-runtime": {
      "browser": {
        "types": "./src/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "import": {
        "types": "./src/jsx-runtime.d.ts",
        "default": "./src/jsx-runtime.js"
      },
      "require": {
        "types": "./dist/jsx-runtime.d.cts",
        "default": "./src/jsx-runtime.cjs"
      }
    },
    "./ui/jsx-dev-runtime": {
      "browser": {
        "types": "./src/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "import": {
        "types": "./src/jsx-runtime.d.ts",
        "default": "./src/jsx-runtime.js"
      },
      "require": {
        "types": "./dist/jsx-runtime.d.cts",
        "default": "./src/jsx-runtime.cjs"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/",
    "dist/",
    "assets/fonts/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "prepack": "node tools/check-build.mjs",
    "test": "node --test test/*.test.mjs",
    "check:types": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.cloudflare.json && tsc -p tsconfig.jsx.json && tsc -p tsconfig.jsx.json --jsx react-jsxdev && tsc -p tsconfig.jsx.browser.json && tsc -p tsconfig.jsx.browser.json --jsx react-jsxdev && tsc -p tsconfig.jsx.json --jsxImportSource react",
    "verify:native": "node tools/verify-native.mjs",
    "example": "node examples/invoice.mjs",
    "verify:pack": "node tools/verify-pack.mjs",
    "verify:cloudflare": "node tools/check-cloudflare.mjs",
    "verify:cloudflare:starter": "node tools/check-cloudflare-starter.mjs",
    "verify:text": "python tools/verify-installed-text.py",
    "render:fonts": "node tools/render-font-subsets.mjs",
    "verify:fonts": "python tools/verify-font-subsets.py",
    "render:families": "node tools/render-font-families.mjs",
    "verify:families": "python tools/verify-font-families.py output/font-families",
    "build:browser": "node tools/build-browser.mjs",
    "verify:browser:prepare": "node tools/prepare-browser-check.mjs",
    "render:inline": "node tools/render-inline-wrapping.mjs",
    "verify:inline": "python tools/verify-inline-wrapping.py",
    "render:standard": "node tools/render-standard-fonts.mjs",
    "verify:standard": "python tools/verify-standard-fonts.py"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fullbleed-engine/fullbleed-node.git"
  },
  "homepage": "https://github.com/fullbleed-engine/fullbleed-node#readme",
  "bugs": {
    "url": "https://github.com/fullbleed-engine/fullbleed-node/issues"
  },
  "keywords": [
    "pdf",
    "html-to-pdf",
    "pdf-generation",
    "fullbleed",
    "invoice",
    "reports",
    "rust",
    "webassembly",
    "jsx",
    "components",
    "cloudflare-workers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "fullbleed": {
    "engineVersion": "2.5.29"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  },
  "bin": {
    "fullbleed-browser-assets": "src/copy-browser-assets.cjs"
  }
}
